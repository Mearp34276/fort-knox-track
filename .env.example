# Fort Knox — copy to .env and fill in. PUBLIC values only.
# NEVER put a private key, seed phrase, or exchange password here or in chat.

# Your receive address for $0.002 crypto tolls (public address only).
# Leave empty for mock-ledger-only (public default).
FORT_KNOX_TREASURY_ADDRESS=

# Recommended for $0.002 tolls: usdc_base (default) or usdc_solana
FORT_KNOX_TREASURY_CHAIN=usdc_base

# Settlement mode for MVP: mock_ledger | usdc_stub | sol_stub | eth_stub
FORT_KNOX_SETTLEMENT_MODE=mock_ledger

# Live USDC-on-Base send. Hard-off. Do not set true unless counsel + operator-pay flow.
# This process never accepts a private key. Operator pays from their own wallet.
FORT_KNOX_LIVE_SEND=false
# FORT_KNOX_SIGNER_MODE=operator_pay
# FORT_KNOX_SIGNER_URL=
